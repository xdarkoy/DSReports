{
  "name": "reporting-vscode",
  "displayName": "Report Designer",
  "description": "Visueller WYSIWYG Report Designer mit KI-Copilot, eingebettet in VS Code",
  "version": "0.1.0",
  "publisher": "reporting",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "report",
    "designer",
    "rdlc",
    "devexpress",
    "pdf",
    "ai"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "reporting.designer",
        "displayName": "Report Designer",
        "selector": [
          {
            "filenamePattern": "*.myreport"
          },
          {
            "filenamePattern": "*.myreport.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "reporting.newReport",
        "title": "Report Designer: New Report"
      },
      {
        "command": "reporting.preview",
        "title": "Report Designer: Render Preview (PDF)"
      },
      {
        "command": "reporting.setApiKey",
        "title": "Report Designer: Set Anthropic API Key"
      }
    ],
    "configuration": {
      "title": "Report Designer",
      "properties": {
        "reporting.aiModel": {
          "type": "string",
          "default": "claude-sonnet-4-6",
          "description": "Claude model used by the AI copilot."
        },
        "reporting.pythonBackendUrl": {
          "type": "string",
          "default": "http://localhost:8787/render",
          "description": "URL of the Python PDF render backend."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:webview && npm run build:host && npm run typecheck",
    "build:webview": "vite build --config vite.webview.config.ts",
    "build:host": "esbuild src/extension.ts --bundle --outfile=out/extension.js --platform=node --format=cjs --external:vscode --target=node18",
    "typecheck": "tsc --noEmit -p ./",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --platform=node --format=cjs --external:vscode --target=node18 --watch",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@xdarkoy/designer": "0.1.0",
    "@xdarkoy/schema": "0.1.0",
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.27.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.5",
    "vite": "^8.0.16"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/xdarkoy/DSReports.git",
    "directory": "apps/vscode-extension"
  }
}
