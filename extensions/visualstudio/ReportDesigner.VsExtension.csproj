<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ReportDesigner.VsExtension</RootNamespace>
    <AssemblyName>ReportDesigner.VsExtension</AssemblyName>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>true</DeployExtension>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK"            Version="17.0.32112.339" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools"            Version="17.0.5232" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2"                Version="1.0.2210.55" />
    <PackageReference Include="Newtonsoft.Json"                       Version="13.0.3" />
  </ItemGroup>

  <!-- Source\*.cs are auto-included by the SDK; do NOT list them again
       (NETSDK1022 duplicate compile items). -->

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="Resources\webview\**\*.*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Logo.png" Condition="Exists('Resources\Logo.png')">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <!-- Copy the freshly built React webview bundle (produced by
       `npm run build:webview` in apps/vscode-extension) into Resources\webview
       before building, so the VSIX always ships the current designer.js/css.
       See scripts/build-webview.ps1. -->
  <Target Name="CopyWebviewAssets" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <WebviewAsset Include="$(MSBuildProjectDirectory)\..\..\apps\vscode-extension\media\designer.js;$(MSBuildProjectDirectory)\..\..\apps\vscode-extension\media\designer.css" />
    </ItemGroup>
    <Copy SourceFiles="@(WebviewAsset)" DestinationFolder="$(MSBuildProjectDirectory)\Resources\webview"
          SkipUnchangedFiles="true" Condition="'@(WebviewAsset)' != ''" />
  </Target>
</Project>
