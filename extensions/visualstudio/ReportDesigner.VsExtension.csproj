<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ReportDesigner.VsExtension</RootNamespace>
    <AssemblyName>ReportDesigner.VsExtension</AssemblyName>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>true</DeployExtension>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK"            Version="17.0.32112.339" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools"            Version="17.0.5232" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2"                Version="1.0.2210.55" />
    <PackageReference Include="Newtonsoft.Json"                       Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Source\ReportDesignerPackage.cs" />
    <Compile Include="Source\ReportEditorFactory.cs" />
    <Compile Include="Source\ReportEditorPane.cs" />
    <Compile Include="Source\WebViewHost.cs" />
    <Compile Include="Source\NewReportCommand.cs" />
    <Compile Include="Source\OptionsPage.cs" />
    <Compile Include="Source\ClaudeRelay.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <Content Include="Resources\webview\**\*.*">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Logo.png" Condition="Exists('Resources\Logo.png')">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>
</Project>
