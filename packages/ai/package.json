{
  "name": "@reporting/ai",
  "version": "0.1.0",
  "description": "AI co-pilot bindings for @reporting/designer (Claude / OpenAI).",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {
    "@reporting/schema": "0.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.27.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "license": "Apache-2.0"
}
