{
  "name": "reporting-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Moderner webbasierter Report Designer mit KI-Unterstützung – als NPM-Paket, VS Code Extension und Visual Studio Extension",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:designer": "npm run dev --workspace packages/designer",
    "build:designer": "npm run build --workspace packages/designer",
    "build:vscode": "npm run build --workspace apps/vscode-extension",
    "clean": "rimraf packages/*/dist apps/*/dist apps/*/out"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5"
  }
}
